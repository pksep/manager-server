HOST=127.0.0.1
PORT=4314
DATABASE_URL=postgresql://manager:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:56441/manager
MANAGER_INTERNAL_KEY=REPLACE_WITH_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
CHAT_SERVICE_URL=http://127.0.0.1:4501/api
CHAT_MANAGER_KEY=REPLACE_WITH_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
MANAGER_SITES_PATH=config/sites.example.json
MANAGER_QUEUE_LIMIT=10000
MANAGER_SESSION_HOURS=24
MANAGER_WORKER_MS=1000
REDIS_URL=redis://127.0.0.1:56394/14
MANAGER_RABBITMQ_URL=amqp://manager-local:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:55675/manager-service
MANAGER_QUEUE_PREFIX=manager
MANAGER_REDIS_PREFIX=manager:security
# Доверять только адресам собственных прокси; пустое значение для прямого соединения.
MANAGER_TRUSTED_PROXIES=
# disabled разрешён только для loopback-стенда; на сайте adaptive или required.
MANAGER_CAPTCHA_MODE=disabled
# SMARTCAPTCHA_CLIENT_KEY=
# SMARTCAPTCHA_SERVER_KEY=
MANAGER_SCAN_MODE=required
MANAGER_CLAMAV_HOST=127.0.0.1
MANAGER_CLAMAV_PORT=53310
MANAGER_UPLOAD_BYTES=20971520
# VK_BUSINESS_URL=https://vk.com/your_company
# MANAGER_MIGRATION_DATABASE_URL=postgresql://migration_user:REPLACE@127.0.0.1:56441/manager
## Необязательная синхронизация с ЕРП. Указываются вместе; URL включает /api.
