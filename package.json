{
  "name": "@pksep/manager-server",
  "version": "0.1.0",
  "private": true,
  "description": "Сервис обращений между внешними каналами и СЭП Чатом",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "bun dist/main.js",
    "dev": "bun run build && bun --watch dist/main.js",
    "migrate": "bun src/migrate.ts",
    "test": "bun test tests/unit",
    "test:integration": "bun run build && bun --env-file=.env.local test tests/bridge.integration.test.ts --timeout 30000",
    "test:erp": "bun run build && bun --env-file=.env.local test tests/erp.integration.test.ts --timeout 30000",
    "test:browser": "bun run build && node --env-file=.env.local scripts/verify-widget.mts",
    "local:setup": "bun scripts/local-setup.ts",
    "local:infra": "docker compose --env-file .env.local -f compose.local.yml up -d --wait",
    "local:chat": "bun scripts/chat-local-setup.ts",
    "local:erp": "bun scripts/erp-local-setup.ts",
    "local:start": "bun run build && bun --env-file=.env.local dist/main.js",
    "format": "prettier --write src tests config *.json"
  },
  "dependencies": {
    "@nestjs/common": "11.1.11",
    "@nestjs/core": "11.1.11",
    "@nestjs/platform-express": "11.1.11",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.16.0",
    "ws": "8.18.3",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "@types/bun": "1.3.9",
    "@types/express": "5.0.6",
    "@types/multer": "2.0.0",
    "@types/node": "25.0.6",
    "@types/pg": "8.15.5",
    "@types/sanitize-html": "2.16.1",
    "@types/ws": "8.18.1",
    "prettier": "3.7.4",
    "typescript": "5.9.3"
  }
}
